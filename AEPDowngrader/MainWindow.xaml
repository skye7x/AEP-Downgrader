<Window x:Class="AEPDowngrader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:AEPDowngrader.Controls"
        xmlns:converters="clr-namespace:AEPDowngrader.Converters"
        Title="AEP Downgrader"
        Width="1040" Height="760"
        MinWidth="900" MinHeight="640"
        Icon="Assets/icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Target version item template with an "EXPERIMENTAL" badge -->
        <DataTemplate x:Key="TargetVersionItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="1" Background="{StaticResource ExperimentalBadgeBrush}" CornerRadius="8" Padding="6,2" Margin="10,0,0,0"
                        Visibility="{Binding IsExperimental, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="EXPERIMENTAL" FontSize="10" FontWeight="Bold" Foreground="White"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Borderless, hover-highlighted buttons for the custom title bar -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseTitleBarButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#E81123">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Custom title bar -->
        <Border DockPanel.Dock="Top" Height="40" Background="{StaticResource CardBrush}"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                    <Image Source="Assets/icon.png" Width="18" Height="18"/>
                    <TextBlock Text="AEP Downgrader" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" ToolTip="Minimize">
                        <Path Data="M 0 0 L 10 0" Stroke="{StaticResource TextBrush}" StrokeThickness="1.2"/>
                    </Button>
                    <Button Style="{StaticResource CloseTitleBarButton}" Click="CloseButton_Click" ToolTip="Close">
                        <Path Data="M 0 0 L 10 10 M 0 10 L 10 0" Stroke="{StaticResource TextBrush}" StrokeThickness="1.2"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Select Files..." Click="SelectFilesButton_Click"/>
                <MenuItem Header="Open Output Folder" Click="ViewOutputButton_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Debug">
                <MenuItem x:Name="ToggleDebugMenuItem" Header="Enable Debug Mode" IsCheckable="True"
                          Checked="ToggleDebugMenuItem_Click" Unchecked="ToggleDebugMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="View Debug Logs..." Click="ViewDebugLogsMenuItem_Click"/>
                <MenuItem Header="Export Debug Report..." Click="ExportDebugReportMenuItem_Click"/>
                <MenuItem Header="System Information" Click="SystemInfoMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Check for Updates..." Click="CheckForUpdatesMenuItem_Click"/>
                <MenuItem Header="About AEP Downgrader" Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <!-- Main content -->
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left sidebar -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Select files and manage output" Margin="0,4,0,14" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" FontSize="12"/>

                        <Button Content="Select Files..." Click="SelectFilesButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button x:Name="ViewOutputButton" Content="Open Output Folder" Click="ViewOutputButton_Click"
                                Style="{StaticResource RegularButtonStyle}" Margin="0,10,0,0"/>

                        <TextBlock x:Name="OutputStatusLabel"
                                   Text="Converted files will be saved next to selected input files."
                                   Margin="0,12,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap">
                            Converts Adobe After Effects project files from newer versions to older ones,
                            preserving layers and assets.
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Main panel -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Convert Projects" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Drop one or more .aep files below, choose a target version, and convert."
                               Margin="0,4,0,16" Foreground="{StaticResource TextSecondaryBrush}"/>

                    <controls:InputDropZone x:Name="InputDropZoneControl"/>

                    <TextBlock x:Name="DetectedVersionLabel" Text="Detected version: Unknown"
                               Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" Margin="0,12,0,0"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                            <TextBlock Text="Target Version" FontWeight="Bold" Margin="0,0,0,6" Foreground="{StaticResource TextBrush}"/>
                            <ComboBox x:Name="TargetVersionCombo" Style="{StaticResource DarkComboBoxStyle}"
                                      ItemTemplate="{StaticResource TargetVersionItemTemplate}" MinWidth="240" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click"
                                    Style="{StaticResource RegularButtonStyle}" IsEnabled="False" Margin="0,0,10,0"/>
                            <Button x:Name="ConvertButton" Content="Convert" Click="ConvertButton_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,16" Background="{StaticResource BorderBrush2}"/>

                    <StackPanel>
                        <TextBlock Text="Progress" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <ProgressBar x:Name="ProgressBarControl" Style="{StaticResource DarkProgressBarStyle}"
                                     Margin="0,8,0,12" Minimum="0" Maximum="100"/>

                        <TextBlock Text="Activity Log" FontWeight="Bold" Margin="0,0,0,6" Foreground="{StaticResource TextBrush}"/>
                        <TextBox x:Name="LogTextBox" Style="{StaticResource DarkTextBoxStyle}"
                                 Height="180" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
